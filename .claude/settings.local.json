{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"cleanupPeriodDays": 10,
	"plansDirectory": "./plans",
	"permissions": {
		"allow": [
			"Read",
			"Glob",
			"Grep",
			"WebFetch",
			"WebSearch",
			"Bash(git log *)",
			"Bash(git status *)",
			"Bash(git diff *)",
			"Bash(git show *)",
			"Bash(git branch *)",
			"Bash(cat *)",
			"Bash(ls *)",
			"Bash(echo *)",
			"Bash(pwd)",
			"Bash(which *)",
			"Bash(find *)",
			"Bash(grep *)",
			"Bash(wc *)",
			"Bash(head *)",
			"Bash(tail *)",
			"Bash(env)",
			"Bash(printenv *)",
			"Bash(ps *)",
			"Bash(df *)",
			"Bash(du *)",
			"Bash(uname *)",
			"Bash(whoami)",
			"Bash(date)"
		],
		"ask": [
			"Bash(gh pr create:*)",
			"Bash(git commit:*)",
			"Bash(rm *)",
			"Bash(mv *)",
			"Bash(cp *)",
			"Bash(mkdir *)",
			"Bash(touch *)",
			"Bash(chmod *)",
			"Bash(chown *)",
			"Bash(sudo *)",
			"Bash(git commit *)",
			"Bash(git push *)",
			"Bash(git merge *)",
			"Bash(git reset *)",
			"Bash(git checkout *)",
			"Bash(npm install *)",
			"Bash(pip install *)"
		],
		"deny": ["Write(*.env)", "Bash(rm:*)"],
		"defaultMode": "default"
	}
}
