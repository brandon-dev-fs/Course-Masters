DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<dbname>
SERVER_PORT=5002
NODE_ENV=development
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars-long
CLIENT_URL=http://localhost:5000
LOG_LEVEL=info

# Object storage (GarageHQ) — required for file assignment uploads/downloads
# Run scripts/garage-init.sh after starting Docker to obtain the key ID and secret
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=course-masters
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=garage
